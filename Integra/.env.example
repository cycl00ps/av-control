# Amp / app (no secrets committed)
INTEGRA_ADDRESS=192.168.210.114
INTEGRA_EISCP_PORT=60128
INTEGRA_MOCK=0
INTEGRA_HTTP_ADDR=0.0.0.0:8080
# Optional path prefix when reverse-proxied (e.g. /av)
# INTEGRA_HTTP_BASE=
# Warn before volume crosses this display level (0 disables). Default 55.
INTEGRA_VOL_WARN=55

# Web Setup (optional; not used by integra-web)
user=admin
password=changeme

# Preferred eISCP defaults
listening_mode=40
master_volume=50
center_level=+10
late_night=01
